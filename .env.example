# ==============================================================================
# PostHog Analytics Environment Variables
# ==============================================================================

# Client-Side / Public Keys (Safe to expose to browser)
# Your PostHog Project API Key (Settings -> Project -> Project API Key, starts with phc_)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here

# PostHog Ingestion Host (defaults to https://us.i.posthog.com, or https://eu.i.posthog.com for EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-Side / Secret Keys (NEVER expose to browser / client bundles)
# Required for Admin Analytics Dashboard HogQL queries & server-side capture
# Your numeric PostHog Project ID (found in Project Settings -> General -> Project ID)
POSTHOG_PROJECT_ID=your_numeric_project_id_here

# PostHog Personal API Key (User Settings -> Personal API Keys, starts with phx_)
# Needs "read" permission for project queries
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here

# ==============================================================================
# Database & Authentication (Existing Configuration)
# ==============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DIRECT_URL=postgresql://user:password@localhost:5432/dbname
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000
ADMIN_PASSWORD=your_admin_password_here

# ==============================================================================
# Razorpay Payment Gateway (Existing Configuration)
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
